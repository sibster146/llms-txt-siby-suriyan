{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageProductionTerraformState",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::prod-llms-txt-*-terraform-state",
        "arn:aws:s3:::prod-llms-txt-*-terraform-state/*"
      ]
    },
    {
      "Sid": "ManageProductionBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::prod-llms-txt-s3-*",
        "arn:aws:s3:::prod-llms-txt-s3-*/*",
        "arn:aws:s3:::prod-llms-txt-frontend-*",
        "arn:aws:s3:::prod-llms-txt-frontend-*/*"
      ]
    },
    {
      "Sid": "ManageProductionDataServices",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:*",
        "dynamodb:*",
        "sqs:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageProductionImages",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": "*"
    },
    {
      "Sid": "ManageProductionComputeAndNetworking",
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "ecs:*",
        "elasticloadbalancing:*",
        "lambda:*",
        "logs:*",
        "scheduler:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageProductionCDN",
      "Effect": "Allow",
      "Action": "cloudfront:*",
      "Resource": "*"
    },
    {
      "Sid": "ManageProductionGuestCredentials",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DeleteSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:GetSecretValue",
        "secretsmanager:ListSecretVersionIds",
        "secretsmanager:PutSecretValue",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource",
        "secretsmanager:UpdateSecret"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:prod_llms_txt_guest_credentials-*"
    },
    {
      "Sid": "ManageProductionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRolePolicies",
        "iam:PassRole",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/prod_llms_txt_*"
    },
    {
      "Sid": "CreateAWSServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "ecs.amazonaws.com",
            "elasticloadbalancing.amazonaws.com"
          ]
        }
      }
    }
  ]
}
