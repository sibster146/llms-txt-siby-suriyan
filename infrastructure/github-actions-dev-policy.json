{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDevelopmentTerraformStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:PutEncryptionConfiguration",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketVersioning",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::dev-llms-txt-*-terraform-state",
        "arn:aws:s3:::dev-llms-txt-*-terraform-state/*"
      ]
    },
    {
      "Sid": "ManageDevelopmentCognito",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "*"
    },
    {
      "Sid": "ListDynamoDBTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeLimits",
        "dynamodb:ListTables"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageDevelopmentDynamoDB",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:*:*:table/dev_llms_txt_*"
    },
    {
      "Sid": "ListSQSQueues",
      "Effect": "Allow",
      "Action": "sqs:ListQueues",
      "Resource": "*"
    },
    {
      "Sid": "ManageDevelopmentSQS",
      "Effect": "Allow",
      "Action": "sqs:*",
      "Resource": "arn:aws:sqs:*:*:dev_llms_txt_*"
    },
    {
      "Sid": "ManageDevelopmentApplicationBucket",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::dev-llms-txt-s3-*",
        "arn:aws:s3:::dev-llms-txt-s3-*/*"
      ]
    }
  ]
}
